{
  "name": "autotest-nepakpoint",
  "version": "1.0.0",
  "description": "Automation test for inazone",
  "license": "ISC",
  "author": "Indah Mutiah Utami MZ",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test:ui": "playwright test --ui",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "test-jenkins": "node node_modules/@playwright/test/cli.js test",
    "allure:history": "cp -R allure-report/history allure-results/history || true",
    "allure:gen": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "clean:allure": "rm -rf allure-results allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.8.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
